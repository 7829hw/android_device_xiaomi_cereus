cc_defaults {
    name: "lib_driver_cmd_mt66xx_defaults",
    vendor: true,
    owner: "mtk",
    sanitize: {
        cfi: true,
    },
    cflags: [
        "-DCONFIG_ANDROID_LOG",
        // hapd is assigned but never read in the vendor source
        "-Wno-error=unused-but-set-variable",
    ],
    arch: {
        arm: {
            // To force sizeof(enum) = 4
            cflags: ["-mabi=aapcs-linux"],
        },
    },
    srcs: ["mediatek_driver_cmd_nl80211.c"],
    shared_libs: [
        "libc",
        "libcutils",
    ],
    include_dirs: [
        "external/libnl/include",
        "external/wpa_supplicant_8/src",
        "external/wpa_supplicant_8/src/common",
        "external/wpa_supplicant_8/src/drivers",
        "external/wpa_supplicant_8/src/l2_packet",
        "external/wpa_supplicant_8/src/utils",
        "external/wpa_supplicant_8/src/wps",
        "external/wpa_supplicant_8/wpa_supplicant",
    ],
}

// The library uses the drivers' and the daemons' structs, whose layout
// depends on the CONFIG_* flags, so build it once with the flags of each.
cc_library_static {
    name: "lib_driver_cmd_mt66xx",
    defaults: [
        "lib_driver_cmd_mt66xx_defaults",
        "wpa_supplicant_cflags_default",
        "wpa_supplicant_usd_defaults",
    ],
}

cc_library_static {
    name: "lib_driver_cmd_mt66xx_hostapd",
    defaults: [
        "lib_driver_cmd_mt66xx_defaults",
        "hostapd_cflags_default",
    ],
}
