// hardware/interfaces/audio/core/all-versions/default with guards for HALs
// built against the Android 9 audio.h (device API 3.0), whose stream structs
// end before the fields newer impls read.

cc_library_shared {
    name: "android.hardware.audio@7.0-impl.cereus",
    relative_install_path: "hw",
    vendor: true,
    srcs: [
        "Device.cpp",
        "DevicesFactory.cpp",
        "ParametersUtil.cpp",
        "PrimaryDevice.cpp",
        "Stream.cpp",
        "StreamIn.cpp",
        "StreamOut.cpp",
    ],
    local_include_dirs: ["include"],
    defaults: ["hidl_defaults"],
    static_libs: [
        "libaudiofoundation",
    ],
    shared_libs: [
        "android.hardware.audio@7.0",
        "android.hardware.audio@7.0-util",
        "android.hardware.audio.common@7.0",
        "android.hardware.audio.common@7.0-enums",
        "android.hardware.audio.common@7.0-util",
        "android.hardware.audio.common-util",
        "libbase",
        "libcutils",
        "libfmq",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libmedia_helper",
        "libmediautils_vendor",
        "libmemunreachable",
        "libutils",
    ],
    header_libs: [
        "android.hardware.audio.common.util@all-versions",
        "libaudioutils_headers",
        "libaudio_system_headers",
        "libhardware_headers",
        "libmedia_headers",
        "libmediautils_headers",
    ],
    cflags: [
        "-DMAJOR_VERSION=7",
        "-DMINOR_VERSION=0",
        "-include common/all-versions/VersionMacro.h",
    ],
}
