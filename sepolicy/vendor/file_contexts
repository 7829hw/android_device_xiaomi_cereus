# Labels for ALPS vendor files and nodes not covered by device/mediatek/sepolicy_vndr
/(system\/vendor|vendor)/bin/ipsec u:object_r:ipsec_exec:s0
/(system\/vendor|vendor)/bin/charon u:object_r:charon_exec:s0
/(system\/vendor|vendor)/bin/starter u:object_r:starter_exec:s0
/vendor/lib(64)?/libgralloc_extra\.so u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libunwindstack-v29\.so u:object_r:same_process_hal_file:s0
/data/vendor/ipsec(/.*)? u:object_r:wod_ipsec_conf_file:s0
/dev/socket/wod_sim(/.*)? u:object_r:wod_sim_socket:s0
/dev/socket/wod_dns(/.*)? u:object_r:wod_dns_socket:s0
/dev/socket/wod_ipsec(/.*)? u:object_r:wod_ipsec_socket:s0
/data/vendor/ipsec/wo(/.*)? u:object_r:wod_apn_conf_file:s0
/dev/socket/wod_action(/.*)? u:object_r:wod_action_socket:s0
/dev/socket/volte_imsa1(/.*)? u:object_r:volte_imsa1_socket:s0
/dev/socket/volte_imsvt1(/.*)? u:object_r:volte_imsvt1_socket:s0
/dev/goodix_fp u:object_r:fingerprint_device:s0
/data/vendor/goodix(/.*)? u:object_r:fingerprint_vendor_data_file:s0
/data/gf_data(/.*)? u:object_r:gf_data_file:s0

# HALs whose stock labels do not cover the names we ship
# No alternation: a plain path outranks the AOSP regex for the same file
/vendor/bin/hw/android\.hardware\.audio\.service u:object_r:mtk_hal_audio_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.health-service\.mediatek u:object_r:hal_health_default_exec:s0

# Thermal HAL
/vendor/bin/hw/android\.hardware\.thermal-service\.mediatek u:object_r:hal_thermal_default_exec:s0
/vendor/bin/thermal_symlinks_mediatek                     u:object_r:thermal_symlinks_exec:s0
/dev/thermal(/.*)?                                        u:object_r:thermal_link_device:s0
